# Copy this file to .env and fill in real values. Never commit .env.

# Fine-grained GitHub PAT with Contents read+write on the target repo only.
GITHUB_TOKEN=ghp_replace_me

# owner/name of the repo the agent reads from and writes to.
GITHUB_REPO=LesCondones/helpdesk-ai-grc

# Branch the agent commits to. Default: main.
GITHUB_BRANCH=main

# Ollama model tag (must be pulled locally: `ollama list`).
OLLAMA_MODEL=qwen3:8b

# Ollama server URL. Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
